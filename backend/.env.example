# =======================================================
# EcoPulse AI - Environment Configuration Example
# =======================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env with real credentials into source control.

# Application Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Allowed CORS Origins (comma-separated list for local frontend access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas Integration (Credentials placeholder)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=ecopulse_ai

# External Weather & Air Quality API Configuration
# Default provider is open-meteo (works globally without an API key).
# To use OpenWeather or WAQI, set credentials below:
WEATHER_API_PROVIDER=open-meteo
OPENWEATHER_API_KEY=
WAQI_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_RATE_LIMIT_BACKOFF_SECONDS=60

# Telemetry Simulation Engine Settings
SIMULATOR_UPDATE_INTERVAL_SECONDS=15
SIMULATOR_AUTO_START=false
DEDUPLICATION_WINDOW_SECONDS=30

# Secure JWT Authentication
JWT_SECRET_KEY=ecopulse-jwt-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Environmental Incident Email Dispatch (SMTP)
# Leave SMTP_HOST blank to simulate email notifications in application logs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
ALERT_EMAIL_FROM=alerts@ecopulse.ai
ALERT_NOTIFICATION_EMAIL=operator@ecopulse.ai

