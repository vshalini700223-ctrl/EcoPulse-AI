# =======================================================
# EcoPulse AI - Frontend Environment Configuration Example
# =======================================================
# For local development with Vite dev proxy (default):
# Leave VITE_API_URL empty or unset to use '/api' proxy configured in vite.config.js.
#
# For production deployment on Render / Cloud:
# Set this to the public URL of your deployed FastAPI backend service.
# Example: https://ecopulse-backend.onrender.com
VITE_API_URL=
